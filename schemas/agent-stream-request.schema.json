{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asw:schema:agent-stream-request:v1",
  "title": "ASW agent stream request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "asw.agent_stream_request.v1"
    },
    "agent_subscriber_id": {
      "type": "string",
      "pattern": "^agent:[A-Za-z0-9._-]+$"
    },
    "subscription_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sub_[A-Za-z0-9._-]+$"
      }
    },
    "after": {
      "anyOf": [
        {
          "$ref": "urn:asw:schema:replay-cursor:v1"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "schema_version",
    "agent_subscriber_id",
    "subscription_ids",
    "after",
    "limit"
  ]
}
