{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asw:schema:signal:v1",
  "title": "ASW canonical signal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "asw.signal.v1"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^sig_[A-Za-z0-9._-]+$"
    },
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evt_[A-Za-z0-9._-]+$"
      }
    },
    "application_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "enum": [
        "files",
        "artifacts",
        "processes",
        "jobs",
        "windows_ui",
        "application",
        "diagnostics",
        "shared_artifacts",
        "source_health"
      ]
    },
    "kind": {
      "enum": [
        "file.created",
        "file.modified",
        "file.deleted",
        "file.saved",
        "artifact.available",
        "process.started",
        "process.completed",
        "process.failed",
        "process.crashed",
        "process.restarted",
        "job.completed",
        "job.failed",
        "window.created",
        "dialog.appeared",
        "operation.available",
        "operation.completed",
        "diagnostic.changed",
        "shared_artifact.updated",
        "source.degraded",
        "source.reconciled"
      ]
    },
    "status": {
      "enum": [
        "current",
        "superseded",
        "expired"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "path",
            "artifact",
            "process",
            "job",
            "window",
            "ui_element",
            "diagnostic_set",
            "operation",
            "source",
            "unknown"
          ]
        },
        "value": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "source_reliability": {
      "enum": [
        "authoritative",
        "observed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "frontier": {
      "$ref": "urn:asw:schema:frontier:v1"
    }
  },
  "required": [
    "schema_version",
    "signal_id",
    "derived_from",
    "application_id",
    "category",
    "kind",
    "status",
    "summary",
    "subject",
    "source_reliability",
    "created_at",
    "frontier"
  ]
}
