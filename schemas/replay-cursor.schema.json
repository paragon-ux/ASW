{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asw:schema:replay-cursor:v1",
  "title": "ASW replay cursor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "asw.replay_cursor.v1"
    },
    "cursor_id": {
      "type": "string",
      "pattern": "^cursor_[A-Za-z0-9._-]+$"
    },
    "subscriber_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(user|agent):[A-Za-z0-9._-]+$"
    },
    "frontier": {
      "$ref": "urn:asw:schema:frontier:v1"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "cursor_id",
    "subscriber_id",
    "frontier",
    "issued_at"
  ]
}
