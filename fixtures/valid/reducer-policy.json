{
  "schema_version": "asw.reducer_policy.v1",
  "policy_version": "asw.reducer.v1",
  "default_action": "reject",
  "rules": [
    {
      "rule_id": "rule_file_saved",
      "priority": 100,
      "match": {
        "event_types": [
          "file.saved"
        ],
        "reliability": [
          "authoritative",
          "observed"
        ],
        "requires_authorization": true
      },
      "action": "emit",
      "emit": {
        "category": "files",
        "kind_from_event": true,
        "dedupe_key_fields": [
          "application_id",
          "type",
          "subject.value"
        ],
        "supersession_mode": "same_subject_newer"
      }
    }
  ],
  "created_at": "2026-08-01T12:00:00-04:00"
}
